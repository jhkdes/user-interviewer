# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vapi (Dashboard -> API Keys) — public key only; it's exposed to the browser by design.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Vapi assistant id (Dashboard -> Assistants) — the assistant configured with
# endCallPhrases/maxDurationSeconds per M6's PROGRESS.md notes, and pointed at
# this app's /api/vapi/webhook and /api/vapi/chat/completions.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Vapi private API key (Dashboard -> API Keys) — server-only, never NEXT_PUBLIC.
# Used to fetch a fresh presigned recording URL for playback (M10/M11 recording
# fix) — the URL captured at end-of-call-report time expires after ~33 min.
VAPI_API_KEY=

# Resend (resend.com/api-keys) — sends the post-interview "here's what you
# told us" summary email to participants (#6). RESEND_FROM_EMAIL must be a
# verified sender/domain in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ElevenLabs Conversational AI (Dashboard -> Agents) — the A/B alternative to
# Vapi (see the voice-provider migration plan). Agent id is public, sent to
# the browser; the API key is server-only, used to mint the short-lived
# signed URL the client needs to start a call and to fetch recordings
# on demand from ElevenLabs' conversation-audio API.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
# Signing secret shown when enabling post-call webhooks on the agent
# (Dashboard -> Agent -> Webhooks) — verifies the `elevenlabs-signature`
# header on incoming /api/elevenlabs/webhook requests.
ELEVENLABS_WEBHOOK_SECRET=

# Set to "true" to enable verbose voice-session debug logging (raw custom-LLM
# request/response bodies, raw webhook payloads, per-turn Claude timing).
# Off by default — this content includes real participant conversation text.
# See src/lib/debug.ts.
DEBUG_VOICE_SESSION=
