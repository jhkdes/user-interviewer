# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vapi (Dashboard -> API Keys) — public key only; it's exposed to the browser by design.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Vapi assistant id (Dashboard -> Assistants) — the assistant configured with
# endCallPhrases/maxDurationSeconds per M6's PROGRESS.md notes, and pointed at
# this app's /api/vapi/webhook and /api/vapi/chat/completions.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Vapi private API key (Dashboard -> API Keys) — server-only, never NEXT_PUBLIC.
# Used to fetch a fresh presigned recording URL for playback (M10/M11 recording
# fix) — the URL captured at end-of-call-report time expires after ~33 min.
VAPI_API_KEY=

# Resend (resend.com/api-keys) — sends the post-interview "here's what you
# told us" summary email to participants (#6). RESEND_FROM_EMAIL must be a
# verified sender/domain in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ElevenLabs Conversational AI (Dashboard -> Agents) — the A/B alternative to
# Vapi (see the voice-provider migration plan). Agent id is public, sent to
# the browser; the API key is server-only, used to mint the short-lived
# signed URL the client needs to start a call and to fetch recordings
# on demand from ElevenLabs' conversation-audio API.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
# Signing secret shown when enabling post-call webhooks on the agent
# (Dashboard -> Agent -> Webhooks) — verifies the `elevenlabs-signature`
# header on incoming /api/elevenlabs/webhook requests.
ELEVENLABS_WEBHOOK_SECRET=

# Optional — a third-party tool's endpoint to notify when a participant
# completes their interview. Only called for interviews whose link carried a
# `tracking_id` query param (see notify-completion-webhook.ts). Leave unset
# to disable the feature entirely.
PARTICIPANT_COMPLETION_WEBHOOK_URL=

# Set to "true" to enable verbose voice-session debug logging (raw custom-LLM
# request/response bodies, raw webhook payloads, per-turn Claude timing).
# Off by default — this content includes real participant conversation text.
# See src/lib/debug.ts.
DEBUG_VOICE_SESSION=

# Set to "true" to offer typing as an alternative to the voice interview on
# feedback studies (never discovery studies). Off by default — with it unset
# the participant flow is voice-only. See TEXT_INTERVIEW_MODE.md and
# src/lib/feature-flags.ts.
TEXT_INTERVIEW_MODE_ENABLED=

# Shared secret for the text-interview idle sweep (/api/internal/text-idle-sweep).
# The request must send "Authorization: Bearer <this value>" — Vercel Cron does
# that automatically when CRON_SECRET is set. The sweep refuses to run without
# it. See TEXT_INTERVIEW_MODE.md.
CRON_SECRET=

# Shared secret for the external API (/api/external/*), e.g. the completed-interview
# count for a study. Callers send it as "Authorization: Bearer <this value>". The
# endpoints refuse to serve at all while it is unset. See EXTERNAL_API.md.
EXTERNAL_API_KEY=

# The one study whose completed-interview count the public website may show
# (/api/public/completed-interviews-count). The request cannot choose a study;
# this does. The endpoint answers 503 while it is unset. See EXTERNAL_API.md.
PUBLIC_COUNT_STUDY_ID=
# Optional. Comma-separated browser origins allowed to read that endpoint from a
# web page. Defaults to https://discoverfirst.co; setting it replaces the default,
# so list every origin you need (for example also https://www.discoverfirst.co).
PUBLIC_COUNT_ALLOWED_ORIGINS=

# Optional. The site's public origin, used for the private report link in the
# job-search report email (https://your-site/report/<token>). Falls back to the
# origin of the request that released the report.
APP_BASE_URL=

# Optional. Path to Chrome or Edge, used locally to create the report PDF. It is found
# automatically in the usual install locations; on Vercel a bundled browser is used.
CHROME_EXECUTABLE_PATH=
